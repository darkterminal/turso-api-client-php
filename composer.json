{
    "name": "darkterminal/turso-api-client-php",
    "version": "2.1.0",
    "description": "Turso Platform PHP SDK — typed client for the Turso Platform API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Imam Ali Mustofa",
            "email": "darkterminal@duck.com",
            "role": "Software Freestyle Engineer",
            "homepage": "https://github.com/darkterminal"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/darkterminal"
        },
        {
            "type": "other",
            "url": "https://saweria.co/darkterminal"
        }
    ],
    "autoload": {
        "psr-4": {
            "Darkterminal\\TursoPlatformAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darkterminal\\TursoPlatformAPI\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --memory-limit=1G"
        ]
    }
}
